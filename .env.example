# Modelo do ambiente — copie para `.env.local` e preencha.
# NUNCA commitar o arquivo preenchido; só este modelo, que não tem segredo.
#
# As duas variáveis abaixo saem do painel do Supabase:
#   Project Settings → Data API  →  "Project URL" e "Project API Keys" (anon / public)
#
# São públicas por natureza (vão pro navegador). A proteção real está nas
# policies de RLS do banco — ver README, seção "Segurança".

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...

# Opcional: código da sala padrão quando a URL não traz ?sala=...
# Sem isto, o padrão embutido é "setimo-raio".
# NEXT_PUBLIC_SALA_PADRAO=setimo-raio
